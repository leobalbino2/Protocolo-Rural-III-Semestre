@{
    ViewData["Title"] = "Quem somos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<main>
    <!------------------------------------------- Quem Somos ------------------------------------------->
    <div class="container mt-5 pt-5">
        <h1 class="brdr-bottom3 py-3">Quem somos</h1>

        <div class="brdr-bottom3 py-3">
            <p>
                Somos Leonardo Balbino e Nicoly Whitehead Maria Bonani, alunos da
                Fatec Jahu. Decidimos criar a aplicação web Protocolo Rural,
                baseando-nos na planilha feita no Excel pelo aluno do curso de Meio
                Ambiente, Lucas Vinicius de Pieri. Nosso projeto busca oferecer uma
                ferramenta de fácil acesso e utilização para classificar o grau de
                sustentabilidade de propriedades rurais na região agrícola de Jaú.
            </p>
        </div>

        <div class="m-1 row">
            <div class="col-12 col-lg-3 d-flex flex-column align-items-center text-center my-4">
                <h2>Felipe Pires</h2>
                <p class="mb-3 txt-gray">Aluno no curso de DSM, Fatec Jahu.</p>
                <div class="col-6 p-0">
                    <img class="rounded img-fluid h-3"
                         src="~/imgs/dev.png"
                         alt="Dev Photo"
                         width="225"
                         height="40" />
                </div>
            </div>
            <div class="col-12 col-lg-3 d-flex flex-column align-items-center text-center my-4">
                <h2>Leonardo Balbino</h2>
                <p class="txt-gray">Aluno no curso de DSM, Fatec Jahu.</p>
                <div class="col-6 p-0">
                    <img class="rounded img-fluid h-3"
                         src="~/imgs/dev.png"
                         alt="Dev Photo"
                         width="225"
                         height="40" />
                </div>
                <div class="w-100 mb-4"></div>
            </div>
            <div class="col-12 col-lg-3 d-flex flex-column align-items-center text-center my-4">
                <h2>Nicoly Whitehead</h2>
                <p class="mb-3 txt-gray">Aluna no curso de DSM, Fatec Jahu.</p>
                <div class="col-6 p-0">
                    <img class="rounded img-fluid h-3"
                         src="~/imgs/dev.png"
                         alt="Dev Photo"
                         width="225"
                         height="40"  />
                </div>
            </div>
            <div class="col-12 col-lg-3 d-flex flex-column align-items-center text-center my-4">
                <h2>Vitor Perasoli</h2>
                <p class="mb-3 txt-gray">Aluno no curso de DSM, Fatec Jahu.</p>
                <div class="col-6 p-0">
                    <img class="rounded img-fluid h-3"
                         src="~/imgs/dev.png"
                         alt="Dev Photo" 
                         width="225"
                         height="40" />
                </div>
            </div>
        </div>
    </div>
</main>