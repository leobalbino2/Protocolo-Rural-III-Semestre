@{
    ViewData["Title"] = "Indicadores";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<main>
    <div class="container mt-5 pt-5 pb-5">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="pb-2 mt-4">Gestão de Indicadores</h1>
            <a class="btn btn-sbmt2" data-bs-toggle="modal" data-bs-target="#criarIndicador">Criar Novo Indicador</a>
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead class="fundo-tabela">
                    <tr>
                        <th colspan="3"><h4 class="mb-0">Nome</h4></th>
                        <th><h4 class="mb-0">Estado</h4></th>
                        <th colspan="8"><h4 class="mb-0">Descrição</h4></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody class="table-group-divider border-top-0">
                    <tr>
                        <td colspan="12" class="text-center"><p class="my-2">Nenhum indicador encontrado.</p></td>
                    </tr>

                    <!--
                    <tr>
                      <td colspan="3"><p class="my-2">Indicador Exemplo</p></td>
                      <td><p class="my-2">Ativo</p></td>
                      <td colspan="5"><p class="my-2">Descrição curta do indicador de exemplo.</p></td>
                      <td class="text-end align-middle" colspan="1" style="white-space: normal;">
                        <div class="mb-1">
                          <a href="#" class="btn btn-sbmt2 w-100">Ver</a>
                        </div>
                        <div class="mb-1">
                          <a href="#" class="btn btn-sbmt4 w-100">Alterar</a>
                        </div>
                        <div>
                          <button type="button" class="btn btn-sbmt3 w-100" onclick="if(confirm('Deseja realmente remover este indicador?')){ /* ação */ }">Remover</button>
                        </div>
                      </td>
                    </tr>

                    -->
                </tbody>
            </table>
        </div>

        <div style="height: 15vh"></div>
    </div>

</main>