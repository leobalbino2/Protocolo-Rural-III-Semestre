@using Microsoft.AspNetCore.Http

@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string ActiveClass(string action, string controller = "Home")
    {
        if (string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
            && string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase))
        {
            if (action == "MinhaConta" && controller == "Account")
                return "green-act";
            else
                return "green-actv pag-atual";
        }
        return "";
    }
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Protocolo Rural</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/stylesheet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProtocoloRural.styles.css" asp-append-version="true" />
</head>
<body>
    <!------------------------------------------- Cabeçalho ------------------------------------------->
    <header>
        <nav id="nav" class="navbar fixed-top min-vh-10 d-flex align-items-center fundo-header">
            <div class="container">
                <!------------------------------------------- Logo ------------------------------------------->
                <div class="col-2 d-flex">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <img class="d-none d-lg-block mt-2" src="@Url.Content("~/imgs/logo.png")" alt="logo" width="170" />
                        <img class="d-block d-lg-none" src="@Url.Content("~/imgs/logomobile.png")" alt="logo" width="30" height="32" />
                    </a>
                </div>

                <!------------------------------------------- Menu Desktop ------------------------------------------->
                <div class="col-8 d-none d-lg-block">
                    <ul class="nav me-auto list-inline fs-5 justify-content-center">
                        <li class="nav-item">
                            <a class="nav-link mx-1.5 txt-gray @(ActiveClass("Index", "Home")) list-hvr" asp-controller="Home" asp-action="Index">Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link mx-1.5 txt-gray @(ActiveClass("Sobre", "Home")) list-hvr" asp-controller="Home" asp-action="Sobre">Sobre</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link mx-1.5 txt-gray @(ActiveClass("QuemSomos", "Home")) list-hvr" asp-controller="Home" asp-action="QuemSomos">Quem somos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link mx-1.5 txt-gray @(ActiveClass("Contato", "Home")) list-hvr" asp-controller="Home" asp-action="Contato">Contato</a>
                        </li>

                        @* Links para usuários autenticados *@
                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link mx-1.5 txt-gray @(ActiveClass("Index", "Painel")) list-hvr" asp-controller="Painel" asp-action="Index">Painel</a>
                            </li>

                            @* Links exclusivos para administradores *@
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link mx-1.5 txt-gray @(ActiveClass("Index", "Indicadores")) list-hvr" asp-controller="Indicadores" asp-action="Index">Indicadores</a>
                                </li>
                                @*<li class="nav-item">
                                    <a class="nav-link mx-1.5 txt-gray @(ActiveClass("CreateRole", "User")) list-hvr" asp-controller="User" asp-action="CreateRole">Funções</a>
                                </li>*@
                            }
                        }
                    </ul>
                </div>

                <!------------------------------------------- Login / Perfil Desktop ------------------------------------------->
                <div class="fs-5 col-2 d-none d-lg-flex justify-content-end align-items-center">
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="d-flex align-items-center">
                                <a class="nav-link ms-2 py-2 px-3 txt-green border @(ActiveClass("MinhaConta", "Account")) green-hvr" asp-controller="Account" asp-action="MinhaConta">Minha Conta</a>
                            <a class="nav-link ms-2 py-2 px-3 txt-green border green-hvr" asp-controller="Account" asp-action="Logout">Sair</a>
                        </div>
                    }
                    else
                    {
                        <div>
                            <a class="nav-link ms-2 py-2 px-3 txt-green border green-hvr" asp-controller="Account" asp-action="Login">Acessar</a>
                        </div>
                    }
                </div>

                <!--------------------------------------- Menu Mobile (Hamburger) --------------------------------------->
                <div class="d-lg-none">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarToggleExternalContent" aria-controls="navbarToggleExternalContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>
            </div>

            <!----------------------------------- Conteúdo Colapsável Mobile ----------------------------------->
            <div class="col-12 collapse text-center d-lg-none" id="navbarToggleExternalContent">
                <div id="overlay" class="p-4 d-flex flex-column gap-3">
                    <a class="txt-green text-decoration-none" asp-controller="Home" asp-action="Index"><h1>Início</h1></a>
                    <a class="txt-green text-decoration-none" asp-controller="Home" asp-action="Sobre"><h1>Sobre</h1></a>
                    <a class="txt-green text-decoration-none" asp-controller="Home" asp-action="QuemSomos"><h1>Quem somos</h1></a>
                    <a class="txt-green text-decoration-none" asp-controller="Home" asp-action="Contato"><h1>Contato</h1></a>

                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <a class="txt-green text-decoration-none" asp-controller="Account" asp-action="MinhaConta"><h1>Minha Conta</h1></a>
                        <a class="txt-green text-decoration-none" asp-controller="Painel" asp-action="Index"><h1>Painel</h1></a>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a class="txt-green text-decoration-none" asp-controller="Indicadores" asp-action="Index"><h1>Indicadores</h1></a>
                        }
                        <a class="txt-green text-decoration-none" asp-controller="Account" asp-action="Logout"><h1>Sair</h1></a>
                    }
                    else
                    {
                        <a class="txt-green text-decoration-none" asp-controller="Account" asp-action="Login"><h1>Acessar</h1></a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="py-5 mt-5">
        <div class="container">
            <div class="row align-items-center text-center text-md-start">

                <div class="col-12 col-md-4 mb-4 mb-md-0">
                    <a href="/" class="d-inline-block mb-2">
                        <img src="~/imgs/logo2.png"
                             alt="Logo Protocolo Rural"
                             width="140"
                             class="img-fluid" />
                    </a>
                    <div class="small txt-white">© 2025 - Todos os direitos reservados</div>
                </div>

                <div class="col-12 col-md-4 d-flex justify-content-center">
                    <ul class="nav flex-column flex-md-row text-center">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link txt-white rodape-p">Início</a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Sobre" class="nav-link txt-white rodape-p">Sobre</a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="QuemSomos" class="nav-link txt-white rodape-p">Quem somos</a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Contato" class="nav-link txt-white rodape-p">Contato</a>
                        </li>
                    </ul>
                </div>

                <div class="col-12 col-md-4 text-center text-md-end mt-3 mt-md-0">
                    <div class="mb-2">
                        <span class="fw-semibold txt-white">Contato:</span>
                    </div>

                    <a href="mailto:protocl0rur4l@gmail.com"
                       class="text-light text-decoration-none small d-inline-block"
                       title="Enviar e-mail para protocl0rur4l@gmail.com"
                       aria-label="Enviar e-mail para protocl0rur4l@gmail.com">
                        <img src="~/imgs/mail.png" alt="E-mail Protocolo Rural" width="24" height="24" class="img-fluid" />
                    </a>
                </div>
                </div>

            </div>
        </div>
    </footer>

    <script src="@(Url.Content("~/lib/jquery/dist/jquery.min.js"))"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>