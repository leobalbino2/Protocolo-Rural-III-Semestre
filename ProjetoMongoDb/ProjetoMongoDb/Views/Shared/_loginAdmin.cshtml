@using Microsoft.AspNetCore.Authorization
@if(User.Identity.IsAuthenticated)
{
    @if (User.IsInRole("Administrador"))
    {
        <li class="nav-item">
            <a class="nav-link mx-1.5 txt-gray list-hvr" asp-controller="Indicadores" asp-action="Index">Indicadores</a>
        </li>
        <li class="nav-item">
            <a class="nav-link mx-1.5 txt-gray list-hvr" asp-controller="User" asp-action="CreateRole">Perfil</a>
        </li>
    }
}
